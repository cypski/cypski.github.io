---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Home"
  view="home"
  description="Casimir Wypyski — writing on AI governance, security, and technology policy. Blog, CV, and reading list."
>
  {/*
    The home screen is intentionally empty: the three tags (blog · CV · reading
    list) live in the persistent Nav and sit centred in the viewport while
    data-view="home". This heading is here for SEO / screen readers only.
  */}
  <h1 class="sr-only">Casimir Wypyski</h1>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
