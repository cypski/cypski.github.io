---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, tags } = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout {title} {description} view="blog" ogType="article">
  <article class="container container-reading section">
    <header class="prose-head">
      <p class="eyebrow">Blog</p>
      <h1>{title}</h1>
      {description && <p class="prose-lede">{description}</p>}

      <div class="prose-meta">
        {pubDate && (
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        )}
        {updatedDate && <span>Updated {formatDate(updatedDate)}</span>}
      </div>

      {tags && tags.length > 0 && (
        <ul class="tag-list" aria-label="Tags">
          {tags.map((tag) => <li><span class="tag">{tag}</span></li>)}
        </ul>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <nav class="prose-foot" aria-label="Back to blog">
      <a href="/blog" class="back-link">&larr; All posts</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .prose-head {
    margin-bottom: 2.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }
  .prose-head h1 { margin: 0 0 0.6rem; }
  .prose-lede {
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0 0 1rem;
    max-width: 62ch;
  }
  .prose-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--faint);
    margin-bottom: 0.9rem;
  }

  /* ── Prose typography ──────────────────────────────────── */
  .prose { font-size: 1.02rem; }
  .prose :global(> * + *) { margin-top: 1.25rem; }

  .prose :global(h2) { margin: 2.75rem 0 0.75rem; font-size: 1.5rem; }
  .prose :global(h3) { margin: 2.25rem 0 0.5rem; font-size: 1.2rem; }

  .prose :global(p) { line-height: 1.8; }
  .prose :global(a) { text-decoration: underline; text-underline-offset: 3px; }

  .prose :global(ul), .prose :global(ol) { padding-left: 1.4rem; }
  .prose :global(li) { line-height: 1.75; margin-top: 0.4rem; }
  .prose :global(li)::marker { color: var(--faint); }

  .prose :global(blockquote) {
    border-left: 2px solid var(--border-strong);
    margin: 1.75rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    color: var(--muted);
    font-style: italic;
  }

  /* Images: full reading-width, framed, with optional caption via <em> in alt/figcaption */
  .prose :global(img) {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin-block: 1.75rem;
  }
  .prose :global(figure) { margin: 1.75rem 0; }
  .prose :global(figcaption) {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--muted);
    text-align: center;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .prose :global(th), .prose :global(td) {
    text-align: left;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--border);
  }
  .prose :global(th) { background: var(--surface); font-weight: 600; }

  .prose-foot {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .back-link {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
    text-decoration: none;
  }
  .back-link:hover { color: var(--text-strong); text-decoration: none; }
</style>
